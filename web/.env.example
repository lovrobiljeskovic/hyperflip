NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WRITER_URL=http://localhost:8787
NEXT_PUBLIC_RPC_URL=https://hyperliquid-testnet.drpc.org
# Elysium deployments: HyperEVM RPC for the bridge step, explorer once Kinetiq publishes one.
# NEXT_PUBLIC_CORE_RPC_URL=https://rpcs.chain.link/hyperevm/testnet
# NEXT_PUBLIC_EXPLORER_URL=
# Identity comes from the generated deployment manifest; legacy values must match.
# DEPLOYMENT_FILE=/absolute/path/to/alternate-deployment.json
# NEXT_PUBLIC_CHAIN_ID=998
# NEXT_PUBLIC_PARLAY_VAULT=0x407cdc0b15e8d81f4d122481ecf92dbe07dc0169
# NEXT_PUBLIC_PARLAY_DEPLOY_BLOCK=61906227
NEXT_PUBLIC_INFO_API=https://api.hyperliquid-testnet.xyz/info

# Independent positions: explicit opt-in after subgraph parity verification.
# NEXT_PUBLIC_POSITIONS_SOURCE=subgraph
# POSITIONS_SUBGRAPH_URL=https://your-approved-query-endpoint
# POSITIONS_SUBGRAPH_TOKEN=   # Query-only token, if required; never a management key.
# POSITIONS_RPC_URL=         # Server-only RPC; defaults to the public chain RPC.
# ELYSIUM_RPC=               # Server-only keyed app-chain RPC behind /api/rpc; defaults to NEXT_PUBLIC_RPC_URL.
# Rollback: NEXT_PUBLIC_POSITIONS_SOURCE=legacy, then rebuild the frontend.
