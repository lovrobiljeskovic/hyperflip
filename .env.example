# Both services read this file from the repository root.
TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
# Optional separate RPC or comma-separated fallback list for the writer.
WRITER_RPC=
MARKETS_FILE=registry/markets.json

# Must match your deployed contracts. Keep private keys out of the frontend.
KEEPER_PRIVATE_KEY=
# Deploy-time only: keeper (settle authority) and cold owner for every new OutcomeVault.
KEEPER_ADDRESS=
OWNER_ADDRESS=
WRITER_ADDRESS=
QUOTE_SIGNER_PRIVATE_KEY=
POKER_PRIVATE_KEY=
# Public identity defaults to registry/deployment.testnet.json.
# DEPLOYMENT_FILE=/absolute/path/to/alternate-deployment.json
# Legacy values, when set, must match the selected manifest.
PARLAY_VAULT_ADDRESS=
PARLAY_DEPLOY_BLOCK=
EVM_CHAIN_ID=

# Amounts below are 6-decimal USDC base units: 1000000 = 1 USDC.
MAX_STAKE=1000000
PER_MARKET_CAP=100000000
PER_CLUSTER_CAP=300000000
# Optional per-invite reservation cap; defaults to three maximum-risk quotes.
# PER_CODE_RESERVED_CAP=
# Optional legacy access codes; new signups wait for manual cohort admission.
INVITE_CODES=
CORS_ORIGINS=http://localhost:3000

INFO_API_URL=https://api.hyperliquid-testnet.xyz/info
WRITER_PORT=8787
EDGE_BPS=500
LEG_EDGE_BPS=300
MIN_PREMIUM_BPS=100
MIN_LEGS=2
QUOTE_TTL_MS=10000
# Live in-play prior (Polymarket mid, ESPN fallback). Poll 3s, refuse samples older than 15s.
# Polymarket /midpoint allows 1500 req/10s per IP; ten games at 3s is ~2% of that.
LIVE_PRIOR_POLL_MS=3000
LIVE_PRIOR_STALE_MS=15000
# Mainnet HIP-4 book midpoint as the second live-prior source (D41: read-only, no signer). Unset = off.
MAINNET_INFO_URL=https://api.hyperliquid.xyz/info
LOCKOUT_MS=600000
POKER_INTERVAL_MS=15000
MIN_BOOK_DEPTH=50
# Zero disables freshness checks; only use it for play-money testnet testing.
SPOT_PX_STALE_MS=60000
# Human-readable USDC, unlike the base-unit limits above.
LOW_BANKROLL=100

# Runtime state must survive service restarts and deployments.
QUOTE_JOURNAL_FILE=writer/quotes.jsonl
WAITLIST_FILE=writer/waitlist.json
# SETTLEMENT_CACHE_PATH=/absolute/path/to/settlement-cache.json
POLL_INTERVAL_MS=5000
BALANCE_TIMEOUT_MS=60000
# Signups work without email; manual admission requires Resend.
RESEND_API_KEY=
# Server-to-server approval credential used by the private Google Sheets script.
WAITLIST_ADMIN_TOKEN=
# Optional Google Sheets integration. Both values required together; server-only.
# See ops/google-sheets-waitlist/README.md for the one-time Google account setup.
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_SYNC_SECRET=
