# Both services read this file from the repository root.
TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
# Optional separate RPC or comma-separated fallback list for the writer.
WRITER_RPC=
MARKETS_FILE=registry/markets.json

# Must match your deployed contracts. Keep private keys out of the frontend.
KEEPER_PRIVATE_KEY=
WRITER_ADDRESS=
QUOTE_SIGNER_PRIVATE_KEY=
POKER_PRIVATE_KEY=
PARLAY_VAULT_ADDRESS=
PARLAY_DEPLOY_BLOCK=

# Amounts below are 6-decimal USDC base units: 1000000 = 1 USDC.
MAX_STAKE=1000000
PER_MARKET_CAP=100000000
PER_CLUSTER_CAP=300000000
# Optional per-invite reservation cap; defaults to three maximum-risk quotes.
# PER_CODE_RESERVED_CAP=
INVITE_CODES=
CORS_ORIGINS=http://localhost:3000

INFO_API_URL=https://api.hyperliquid-testnet.xyz/info
WRITER_PORT=8787
EDGE_BPS=500
LEG_EDGE_BPS=300
MIN_PREMIUM_BPS=100
MIN_LEGS=2
QUOTE_TTL_MS=30000
LOCKOUT_MS=600000
POKER_INTERVAL_MS=15000
MIN_BOOK_DEPTH=50
# Zero disables freshness checks; only use it for play-money testnet testing.
SPOT_PX_STALE_MS=60000
# Human-readable USDC, unlike the base-unit limits above.
LOW_BANKROLL=100

# Runtime state must survive service restarts and deployments.
QUOTE_JOURNAL_FILE=writer/quotes.jsonl
WAITLIST_FILE=writer/waitlist.json
# SETTLEMENT_CACHE_PATH=/absolute/path/to/settlement-cache.json
POLL_INTERVAL_MS=5000
BALANCE_TIMEOUT_MS=60000
# Optional email signup; existing invite codes work without it.
RESEND_API_KEY=
