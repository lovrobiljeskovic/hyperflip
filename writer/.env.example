# --- writer service ---
# TESTNET_RPC=            (shared with keeper)
WRITER_ADDRESS=
QUOTE_SIGNER_PRIVATE_KEY=
POKER_PRIVATE_KEY=
# PRICING_MODE=correlated  correlated: research champion copula prices the joint
#                          probability; cross-underlying tickets need a Supported
#                          model (crypto/equities board, needs RESEARCH_* below).
#                          independent: legs multiply, legs sharing a game or
#                          question are refused (same-game); boots from
#                          MARKETS_FILE + PARLAY_VAULT_ADDRESS + PARLAY_DEPLOY_BLOCK
#                          alone (sports beta, ROTATE_MODE=sports).
# PARLAY_VAULT_ADDRESS=    (independent mode only)
# PARLAY_DEPLOY_BLOCK=     (independent mode only)
# INFO_API_URL=https://api.hyperliquid-testnet.xyz/info   (independent mode only)
# QUOTE_JOURNAL_FILE=writer/quotes.jsonl                  (independent mode only)
RESEARCH_ROOT=/opt/hype/research/testnet
RESEARCH_NETWORK_PROFILE_FILE=/opt/hype/registry/research-network.testnet.json
RESEARCH_REQUIRE_ANCHORED_FS=1
# WRITER_PORT=8787
# EDGE_BPS=500
# MIN_PREMIUM_BPS=100     (must match on-chain ParlayVault.minPremiumBps)
# MIN_LEGS=2
MAX_STAKE=
PER_MARKET_CAP=
PER_CLUSTER_CAP=
# PER_CODE_RESERVED_CAP=  (default: MAX_STAKE * (10000/MIN_PREMIUM_BPS - 1) * 3 — cap on one invite code's reserved-but-unminted risk; shared by everyone using that code)
# RHO_BAND_PCT=0.2        (uncertainty half-width on the correlation table; house-favorable end quoted)
# LEG_EDGE_BPS=300        (extra edge per leg past the first — base edge is flat in leg count; 0 restores flat pricing)
# QUOTE_TTL_MS=30000
# MIN_BOOK_DEPTH=50        (min cumulative ask sz, in coin units, before a book price is trusted; thinner books fall back to spotPx)
# SPOT_PX_STALE_MS=60000   (refuse spotPx-fallback quotes when the coin's last book-ask freshness stamp is older; 0 = gate OFF — testnet only, empty books never stamp; never 0 with real bankroll)
# LOCKOUT_MS=600000
# POKER_INTERVAL_MS=15000
# Market registry file path, relative to the repo root. In correlated mode the
# writer reads its registry only through RESEARCH_NETWORK_PROFILE_FILE; in
# independent mode this is the writer's registry too.
MARKETS_FILE=registry/markets.json
# Comma-separated valid invite codes; POST /quote without one is 403.
# Waitlist-issued codes (writer/waitlist.json) are accepted alongside these.
INVITE_CODES=
# Resend API key for waitlist invite emails; unset disables POST /waitlist.
RESEND_API_KEY=
# WAITLIST_FILE=writer/waitlist.json   (waitlist store, relative to repo root)
# CORS_ORIGINS=https://overround.xyz,https://overround-wine.vercel.app
# Comma-separated browser-origin allowlist for /quote, /waitlist, /limits,
# /health, /metrics. GET /markets stays CORS-open (*) — public registry data.
# Browser-enforcement only, not auth: a non-browser caller ignores this.
