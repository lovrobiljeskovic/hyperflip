[Unit]
Description=hype research daily derivation and validation
After=network-online.target
After=hype-research-collector.service
Wants=network-online.target

[Service]
Type=oneshot
User=hype
WorkingDirectory=/opt/hype/writer
EnvironmentFile=/opt/hype/research.env
Environment=RESEARCH_REQUIRE_ANCHORED_FS=1
ExecStart=/usr/bin/flock -w 900 /opt/hype/research/testnet/state/job.lock /usr/bin/npm run research -- daily
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=2h
