[Unit]
Description=Rotate outcome markets (deploy fresh, prune expired)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hype/repo
Environment=PATH=/root/.foundry/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ROTATE_MODE=sports
ExecStart=/usr/bin/node tools/rotate-markets.mjs
# Restart writer + keeper only when the registry actually changed; an hourly
# no-op run must not kill in-flight quotes.
ExecStartPost=/bin/sh -c '[ /opt/hype/registry/markets.json -nt /run/rotate.stamp ] && systemctl restart writer keeper; touch /run/rotate.stamp'
